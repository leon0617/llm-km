# ── LLM 路由 ──────────────────────────────────────────────────
# 同 tier 內的負載分擔策略：round-robin / pinned-by-user / weighted
LLM_ROUTING=round-robin

# 各操作預設 tier（cheap → Gemini Flash 級、premium → Claude Sonnet 級）
# auto = 啟發式（短/簡單 → cheap、長/含分析關鍵字 → premium）
# 取消註解可覆寫預設
# ROUTE_QUERY=auto       # 員工聊天
# ROUTE_LINT=cheap       # 唯讀健檢
# ROUTE_INGEST=premium   # 文件整理（長 context、品質敏感）
# ROUTE_REFLECT=premium  # 合成洞察

# ── Anthropic（必填一組以上 provider）────────────────────────
ANTHROPIC_ENABLED=true
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_CONCURRENT=6
ANTHROPIC_WEIGHT=1
ANTHROPIC_TIER=premium       # cheap | premium
# 若使用 Proxy（如 LiteLLM proxy），填入完整 base URL
# ANTHROPIC_BASE_URL=https://your-proxy.example.com

# ── OpenAI（選填）────────────────────────────────────────────
# OPENAI_ENABLED=true
# OPENAI_API_KEY=sk-xxx
# OPENAI_MODEL=gpt-4o
# OPENAI_MAX_CONCURRENT=6
# OPENAI_WEIGHT=1
# OPENAI_TIER=premium                    # cheap | premium
# OPENAI_BASE_URL=                       # 同 Anthropic：proxy 才需要

# ── Gemini（選填）────────────────────────────────────────────
# GEMINI_ENABLED=true
# GEMINI_API_KEY=AIzaxxx
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_MAX_CONCURRENT=6
# GEMINI_WEIGHT=1
# GEMINI_TIER=cheap                      # cheap | premium

# ── 認證 ─────────────────────────────────────────────────────
# 產生方式：openssl rand -hex 32
SECRET_KEY=change-me-at-least-32-chars-random-string-here

# 首次啟動自動建立的管理員帳號（啟動後請立即至管理頁面修改密碼）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!

# ── Git 同步（選填）─────────────────────────────────────────
# Wiki 頁面每日自動 push 到此 remote（供 Obsidian 同步）
# GIT_REMOTE=git@github.com:your-org/obsidian-wiki.git

# ── Cookie 安全旗標 ─────────────────────────────────────────
# 預設 true（生產環境走 HTTPS）。本機 http://localhost 開發時設 false。
# COOKIE_SECURE=true

# ── Active Directory（選填）─────────────────────────────────
# 預設關閉。啟用後，管理員可將特定帳號標記為 auth_source=ad，
# 登入時透過 LDAP bind 到公司 AD 認證；密碼不存在本地。
# 本地帳號（auth_source=local）不受影響，仍可正常登入。
#
# AD_ENABLED=true
# AD_HOST=dc1.athena.local
# AD_PORT=636
# AD_USE_SSL=true
# AD_BASE_DN=DC=athena,DC=local
#
# AD_BIND_FORMAT 三選一：upn / ntlm / dn
# AD_BIND_FORMAT=upn
# AD_UPN_SUFFIX=athena.local        # 給 upn 用：john → john@athena.local
# AD_NETBIOS=ATHENA                 # 給 ntlm 用：john → ATHENA\john
# AD_USER_DN_SUFFIX=OU=Users,DC=athena,DC=local   # 給 dn 用

# ── 其他（通常不需修改）────────────────────────────────────
# WIKI_DATA_DIR=/data
# CORS_ORIGINS=http://localhost:3000
